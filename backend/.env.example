NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

DATABASE_URL=postgresql://user:password@localhost:5432/truefeed
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

JWT_ACCESS_SECRET=replace-with-32-plus-random-chars
JWT_REFRESH_SECRET=replace-with-32-plus-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
